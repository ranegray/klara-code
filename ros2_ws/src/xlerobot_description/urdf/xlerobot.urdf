  <!--
    head_camera_rgb_frame and head_camera_depth_frame were removed: the
    realsense2_camera driver publishes head_camera_color_frame,
    head_camera_color_optical_frame, head_camera_depth_frame, and
    head_camera_depth_optical_frame under head_camera_link using the D435i
    factory calibration (real color/depth baseline offset). The previous
    URDF entries assumed coincident sensors at zero offset, which conflicts
    with the realsense-published transforms by frame name and is also
    incorrect.
  -->

  <joint name="joint_0" type="fixed">
